# Backend API base URL (consumed by Nuxt runtimeConfig.apiBaseUrl)
API_BASE_URL=http://localhost:8080

# Admin backend base URL (apps/admin). Falls back to API_BASE_URL if unset.
# ADMIN_API_BASE_URL=http://localhost:3001

# Server runtime (used by the Nitro production server / Docker)
HOST=0.0.0.0
PORT=4000

# Google OAuth 2.0 Web Client ID (must match backend google.client_id)
GOOGLE_CLIENT_ID=
